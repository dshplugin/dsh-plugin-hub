{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "typeRoots": ["./node_modules/@types"],
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["tsdown.config.ts", "scripts", "src/client", "src/server", "tests"]
}
